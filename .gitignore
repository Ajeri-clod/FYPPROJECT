# dependencies
/node_modules
/.pnp
.pnp.*

# build output
/dist
/build
/.output
/.nitro
/.tanstack

# cloudflare (wrangler local cache + generated types; wrangler.jsonc is committed)
/.wrangler
worker-configuration.d.ts

# generated
src/routeTree.gen.ts
*.tsbuildinfo

# testing
/coverage

# env files
.env*
!.env.example

# editor / os
.DS_Store
*.pem
.vercel
.serena
.vscode/
.idea/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# backend templates: commit the source, ignore anything installed/built locally
backends/**/node_modules
backends/**/.venv
backends/**/__pycache__
backends/**/.pytest_cache
backends/**/.ruff_cache
backends/**/dist
backends/**/.output
backends/**/*.db
backends/**/*.sqlite
backends/**/.env

# Raw agency data (contains personal data) — never commit. Only the aggregated
# src/data/oku-stats.json built by scripts/build_oku_stats.py is committed.
/data/raw/
*.xlsx
*.xls
*.csv

# scraper (Python)
scraper/.venv/
scraper/output/
scraper/.scrapling_cache/
__pycache__/
.pytest_cache/

# downloaded by share-dashboard.bat
/tools/
